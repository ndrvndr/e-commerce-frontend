# ================================================
# Ecommerce Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# ================================================

# Base URL of the Laravel backend API
# No trailing slash. No /api suffix.
# Local:      http://localhost:8000
# Production: https://your-laravel.onrender.com
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Resend API Key — used by the contact form (server-side only)
# Get your key at: https://resend.com
# Leave blank to disable the contact form email feature.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Recipient email address for contact form submissions
# Messages sent via the contact page will be delivered to this address.
RESEND_TO_EMAIL=your@email.com
